function Internal:OrbitFarmer(v)

    if not v then

        if Internal.OrbitCon then Internal.OrbitCon:Disconnect() ; Internal.OrbitCon = nil end

        return

    else

        if Internal.OrbitCon then Internal.OrbitCon:Disconnect() ; Internal.OrbitCon = nil end

        local FarmerPlayer = S.Players:FindFirstChild(Farmer)

        if not FarmerPlayer then return end

        Internal.OrbitAngle = 0

        Internal.OrbitCon = S.RunService.RenderStepped:Connect(function(dt)

            local Character = S.Workspace[Player.Name]
            local FarmerCharacter = S.Workspace[FarmerPlayer.Name]

            if not Character or not FarmerCharacter then return end

            local Root = Character:FindFirstChild("HumanoidRootPart")
            local FarmerRoot = FarmerCharacter:FindFirstChild("HumanoidRootPart")
            local Humanoid = Character:FindFirstChildOfClass("Humanoid")

            if not Root or not FarmerRoot or not Humanoid then print(3) return end

            if Humanoid.Health <= 0 then
                Internal:OrbitFarmer(false)
                return
            end

            if not TargetFrame.Visible then
                Internal:OrbitFarmer(false)
                return
            end

            Internal.OrbitAngle += math.rad(120) * dt

            local Offset = Vector3.new(
                math.cos(Internal.OrbitAngle) * 4,
                0,
                math.sin(Internal.OrbitAngle) * 4
            )

            local Position = FarmerRoot.Position + Offset

            Root.CFrame = CFrame.lookAt(Position, FarmerRoot.Position)

        end)

    end

end

function Internal:IsFarmer()
    return getgenv().Farmer == S.Player.Name and true or false
end

function Internal:StartKnifePoll(v)
    if not v and Internal.KnifePoll then Internal.KnifePoll:Disconnect() ; Internal.KnifePoll = nil return end

    if v and not Internal.KnifePoll then

        Internal.KnifePoll = S.RunService.Stepped:Connect(function()
            if Player.Character and not StabCooldown and TargetFrame.Visible then

                if Player:DistanceFromCharacter(S.Workspace[TargetFrane.TargetText.Text].Head.Position) <= 6.5 then
                    Player.PlayerScripts.localknifehandler.HitCheck:Fire(S.Workspace[TargetFrame.TargetText.Text])

                    coroutine.wrap(function()
                        StabCooldown = true
                        task.wait(0.725)
                        StabCooldown = false
                    end)()

                else

                    task.wait()

                end

            end
        end)

    else

        Internal.KnifePoll:Disconnect() ; Internal.KnifePoll = nil

    end
end

